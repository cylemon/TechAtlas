# 应用配置
# 生成接口的访问令牌（请求时通过 X-API-Key 头携带）。
# 留空表示关闭鉴权，仅限本地开发；部署到公网前必须设置
API_TOKEN=

# 允许跨域访问的前端来源，逗号分隔。部署时改成真实前端域名
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# DeepSeek 配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 单次请求超时（秒）。生成一张完整图谱属于长耗时请求，按需调整
DEEPSEEK_TIMEOUT=90

# 未来预留：其他厂商配置（按需添加）
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o